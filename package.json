{
  "packageManager": "yarn@4.18.0",
  "name": "file-sucker",
  "version": "0.1.14",
  "description": "Grab files from phone to laptop very over WIFI",
  "bin": "./server.mjs",
  "files": [
    "server.mjs",
    "server-out/",
    "dist/",
    "entry/address.mjs",
    "entry/static.mjs"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "compile": "calcit calcit.cirru js",
    "build": "yarn compile && vite build",
    "dev": "vite",
    "compile-server": "calcit calcit.cirru --entry server --emit-path server-out/ js",
    "w-server": "calcit -w calcit.cirru --entry server --emit-path server-out/"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:mvc-works/file-sucker.git"
  },
  "author": "jiyinyiyong",
  "license": "MIT",
  "devDependencies": {
    "axios": "^1.3.4",
    "bottom-tip": "^0.1.4",
    "http-server": "^14.1.1",
    "vite": "8.3.3"
  },
  "dependencies": {
    "@calcit/procs": "0.32.1",
    "chalk": "^5.2.0",
    "dayjs": "^1.11.7",
    "finalhandler": "^1.2.0",
    "formidable": "^3.5.4",
    "latest-version": "^7.0.0",
    "prettysize": "^2.0.0",
    "qrcode-terminal": "^0.12.0",
    "serve-static": "^2.2.1"
  }
}
